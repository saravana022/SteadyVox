      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Total Screening Invocations",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(http_requests_total{handler=~'.*screen.*'})",
          "legendFormat": "Screenings",
          "refId": "A"
        }
      ]
