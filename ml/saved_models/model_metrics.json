    "pr_auc_ci": [
      0.8386,
      0.9327
    ],
    "brier_score": 0.2138,
    "specificity": 0.8958,
    "sensitivity": 0.4762,
    "balanced_accuracy": 0.686,
    "f1_score": 0.6306,
    "pct_healthy_non_elevated": 89.58,
    "confusion_matrix": {
      "tn": 43,
      "fp": 5,
      "fn": 77,
      "tp": 70
    }
  },
  "risk_bands": {
    "low": "< 0.30",
    "uncertain": "0.30 - 0.60",
    "elevated": "> 0.60",
    "operating_threshold": 0.6
  },
  "ood_guard": {
    "method": "Ledoit-Wolf Mahalanobis Distance",
    "p99_threshold": 61.36
  }
