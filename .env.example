# SteadyVox Environment Configuration Template
# Copy to .env for local development

# Environment & Debug
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=steadyvox-super-secure-dev-secret-key-change-in-prod

# Disclaimer (Mandatory research banner)
DISCLAIMER_TEXT="Research screening tool only — not a medical diagnosis."

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="SteadyVox"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=steadyvox_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/steadyvox_db

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=steadyvox-audio
S3_REGION=us-east-1
S3_USE_SSL=False

# Primary Clinical Ground-Truth Model (Oxford Real Dataset)
PRIMARY_MODEL_NAME="Tabular MLP (Clinical Ground Truth)"
PRIMARY_MODEL_VERSION="2.1.0-oxford"
PRIMARY_MODEL_PROVENANCE="Oxford Parkinson's Disease Dataset (UCI ML Repository, 195 recordings, Little et al.)"
MODEL_PATH=ml/saved_models/tabular_mlp_best.pt

# Secondary Acoustic Model (Synthetic Ablation Benchmark)
SECONDARY_MODEL_NAME="CNN + BiLSTM (Acoustic Spectrogram)"
SECONDARY_MODEL_VERSION="1.0.0-synthetic-benchmark"
SECONDARY_MODEL_PROVENANCE="Sustained /a/ biophysical simulation benchmark (600 speakers, synthetic ablation)"
AUDIO_MODEL_PATH=ml/saved_models/cnn_bilstm_best.pt

# Audio & Processing Defaults
SAMPLE_RATE=16000
AUDIO_DURATION_SECONDS=3.0

# 3-Tier Risk Stratification Thresholds (< 0.40 Low, 0.40-0.70 Uncertain, > 0.70 Elevated)
RISK_LOW_THRESHOLD=0.40
RISK_ELEVATED_THRESHOLD=0.70

# Audio Quality Gate Rules
MIN_AUDIO_DURATION_SECONDS=1.0
MAX_AUDIO_DURATION_SECONDS=12.0
MAX_FILE_SIZE_BYTES=15728640
MIN_SNR_DB=9.0
MAX_CLIPPING_RATIO=0.03
MAX_SILENCE_RATIO=0.75

# Prometheus Monitoring
PROMETHEUS_METRICS_ENABLED=True

# AWS EC2 Deployment
EC2_HOST=13.201.193.223
AWS_REGION=ap-south-1

