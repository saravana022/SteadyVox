# SteadyVox Environment Configuration Template
# Copy to .env for local development

# Environment & Debug
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=steadyvox-super-secure-dev-secret-key-change-in-prod

# Disclaimer (Mandatory research banner)
DISCLAIMER_TEXT="Research screening tool only — not a medical diagnosis."

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="SteadyVox"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=steadyvox_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/steadyvox_db

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=steadyvox-audio
S3_REGION=us-east-1
S3_USE_SSL=False

# Model Settings
MODEL_PATH=ml/saved_models/cnn_baseline_best.pt
MODEL_ARCHITECTURE=cnn_baseline
CONFIDENCE_THRESHOLD=0.50

# Prometheus Monitoring
PROMETHEUS_METRICS_ENABLED=True

# AWS EC2 Deployment
EC2_HOST=13.201.193.223
AWS_REGION=ap-south-1
